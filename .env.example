# Supabase Configuration
# Get these values from your Supabase project settings
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# UPI Payment Configuration
VITE_UPI_ID=your-upi-id
VITE_MERCHANT_NAME=Shabdashri

# Server-side upload configuration for Vercel API -> GoDaddy hosting (FTPS)
GODADDY_FTP_HOST=ftp.yourdomain.com
GODADDY_FTP_PORT=21
GODADDY_FTP_USER=your-ftp-user
GODADDY_FTP_PASSWORD=your-ftp-password
GODADDY_FTP_SECURE=true
GODADDY_FTP_REMOTE_DIR=/public_html/media.graphicvishwa.com/uploads/products
GODADDY_PUBLIC_BASE_URL=https://media.graphicvishwa.com/uploads/products
UPLOAD_ADMIN_EMAILS=contact.shabdashri@gmail.com
SECRET_KEY=replace-with-a-long-random-secret

# Frontend uploads now use the local /api/upload-image server route.
# Do not expose FTP credentials or upload tokens in VITE_ variables.
